<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <title data-lang-id="<%= titleId %>">‎</title>
    <%/* 从 cdn.json 统一生成预加载标签 */%>
    <% cdn.preload.forEach(function(item) { %>
    <link rel="preload" href="<%= item.href %><%= item.cacheBust ? '?v=' + buildHash : '' %>" as="<%= item.as %>"<% if (item.crossorigin) { %> crossorigin<% } %>>
    <% }); %>
    <% cdn.preconnect.forEach(function(url) { %>
    <link rel="preconnect" href="<%= url %>" crossorigin>
    <% }); %>
    <% cdn.dnsPrefetch.forEach(function(url) { %>
    <link rel="dns-prefetch" href="<%= url %>">
    <% }); %>
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
</head>
